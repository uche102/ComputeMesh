# GenLayer deployment (private key is required only when deploying)
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_PRIVATE_KEY=
GENLAYER_NETWORK=studionet

# Frontend (copy these into frontend/.env for Vite)
# Frontend values belong in frontend/.env, not in the root deployment config.

# Read-only X Layer TapeOut integration. No X Layer private key is required.
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_CHAIN_ID=196
XLAYER_FACTORY_ADDRESS=0x1f09DAeFA827f02CBb40967cc91b259763760761
XLAYER_PROCESSOR_ADDRESS=0x839bdD6fA7A66416A609A735E11De5411B98574E
XLAYER_CIRCUIT_ID=1
